<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}Ramya Iyer - {{ title }}{% else %}Ramya Iyer{% endif %}</title>

  <!-- Bricolage Grotesque + Cormorant Garamond via Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,200..800&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/glightbox/3.3.1/css/glightbox.min.css">
</head>
<body style="--page-bg: {{ background or '#000000' }};">
  <header class="site-header" id="top">
    {% if isProjectPage %}
    <a class="back-link" href="/">&larr; Back to all projects</a>
    {% else %}
    <a class="site-title" href="/">Ramya Iyer</a>
    <nav class="site-nav">
      <a href="/info/">Info + Updates</a>
    </nav>
    {% endif %}
  </header>

  <main>

    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <a href="#top" id="back-to-top">&uarr; Back to top</a>
  </footer>

  <script>
    (function () {
      var link = document.getElementById("back-to-top");
      function update() {
        link.style.display = window.scrollY > 200 ? "inline" : "none";
      }
      window.addEventListener("scroll", update);
      update();
    })();
  </script>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/glightbox/3.3.1/js/glightbox.min.js"></script>
  <script>
    document.addEventListener("DOMContentLoaded", () => {
      document.querySelectorAll(".photo-grid[data-folder]").forEach((grid) => {
        const folder = grid.dataset.folder;
        const gallery = grid.dataset.gallery || "gallery";
        const lines = grid.textContent.split("\n").map((l) => l.trim()).filter(Boolean);
        grid.innerHTML = lines.map((line) => {
          const [file, caption] = line.split("::").map((s) => s && s.trim());
          const src = folder + file;
          const titleAttr = caption ? ` data-title="${caption}"` : "";
          return `<a href="${src}" class="glightbox" data-gallery="${gallery}"${titleAttr}><img src="${src}" alt=""></a>`;
        }).join("");
      });

      GLightbox({
        selector: ".glightbox",
        closeButton: true,
        escKey: true,
        outsideClick: true,
      });
    });
  </script>

</body>
</html>